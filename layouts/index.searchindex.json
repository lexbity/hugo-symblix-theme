{{- $rootName := site.Params.docs.root | default "docs" -}}
{{- $docsRoot := false -}}
{{- with where site.Home.Sections "Section" $rootName -}}
  {{- $docsRoot = index . 0 -}}
{{- end -}}
{{- $entries := slice -}}
{{- with $docsRoot -}}
  {{- $derived := partialCached "docs/helpers/versions.html" . .Site.Language.Lang -}}
  {{- $noindexArchived := site.Params.docs.versions.noindexArchived | default false -}}
  {{- range .RegularPagesRecursive -}}
    {{- if and .Params.nav .Params.nav.hidden -}}
      {{- continue -}}
    {{- end -}}
    {{- /* Archived versions excluded from the index match the noindex and
           sitemap policy: they are not surfaced to readers or crawlers. */ -}}
    {{- if $noindexArchived -}}
      {{- $pageVersion := partial "docs/helpers/current-version.html" . | strings.TrimSpace -}}
      {{- $archived := false -}}
      {{- range where $derived.list "id" $pageVersion -}}
        {{- $archived = .archived -}}
      {{- end -}}
      {{- if $archived -}}
        {{- continue -}}
      {{- end -}}
    {{- end -}}
    {{- /* Code blocks dominate index size and rarely improve ranking; drop
           them before plainifying. */ -}}
    {{- $prose := replaceRE `(?s)<pre\b.*?</pre>` " " .Content -}}
    {{- $content := trim (plainify $prose) " \n\t" -}}
    {{- $description := trim (plainify (.Description | default "")) " \n\t" -}}
    {{- $entries = $entries | append (dict
      "title" .Title
      "description" $description
      "url" .RelPermalink
      "language" site.Language.Lang
      "version" (partial "docs/helpers/current-version.html" . | strings.TrimSpace)
      "docType" (.Params.docType | default "")
      "topics" (.Params.topics | default .Params.tags | default slice)
      "content" $content
    ) -}}
  {{- end -}}
{{- end -}}
{{- $entries | jsonify -}}