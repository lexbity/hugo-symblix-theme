{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- $versions := hugo.Data.docs_versions.versions | default slice -}}
  {{- $noindexArchived := site.Params.docs.versions.noindexArchived | default false -}}
  {{- range .Data.Pages -}}
    {{- $version := partial "docs/helpers/current-version.html" . | strings.TrimSpace -}}
    {{- $archived := false -}}
    {{- range where $versions "id" $version -}}
      {{- $archived = .archived -}}
    {{- end -}}
    {{- if and $noindexArchived $archived -}}
      {{- continue -}}
    {{- end -}}
    {{- if .Permalink -}}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" | safeHTML }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}{{ if .IsTranslated }}{{ $selfCode := partial "docs/helpers/language-code.html" . }}{{ range .Translations }}
    <xhtml:link rel="alternate" hreflang="{{ partial "docs/helpers/language-code.html" . }}" href="{{ .Permalink }}"/>{{ end }}
    <xhtml:link rel="alternate" hreflang="{{ $selfCode }}" href="{{ .Permalink }}"/>
    {{- end }}
  </url>
    {{- end -}}
  {{- end -}}
</urlset>
