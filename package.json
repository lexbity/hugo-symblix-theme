{
  "name": "symblix",
  "private": true,
  "scripts": {
    "dev": "HUGO_PARAMS_DOCS_TAILWINDSOURCE=true hugo server --source exampleSite --theme hugo-theme-symblix",
    "dev:prebuilt": "hugo server --source exampleSite --theme hugo-theme-symblix",
    "serve:test": "npm run diagrams && hugo server --source exampleSite --theme hugo-theme-symblix --bind 127.0.0.1 --port 1313 --disableFastRender --buildDrafts --buildFuture",
    "diagrams": "node scripts/render-diagrams.mjs --content exampleSite/content --out exampleSite/assets/diagrams",
    "build": "npm run diagrams && hugo --source exampleSite --theme hugo-theme-symblix --cleanDestinationDir",
    "check": "npm run diagrams && hugo --source exampleSite --theme hugo-theme-symblix --panicOnWarning --cleanDestinationDir",
    "build:css": "tailwindcss -i assets/css/input.css -o assets/css/compiled/theme.css --minify",
    "test": "playwright test",
    "test:install": "playwright install --with-deps chromium",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "lint:motion": "eslint assets/js/motion.js assets/js/motion exampleSite/assets/js/scenes",
    "test:motion:unit": "node tests/unit/motion-scheduler.test.mjs && node tests/unit/motion-scope.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.4",
    "@mermaid-js/mermaid-cli": "^11.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.3.0",
    "eslint": "10.14.0",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1",
      "@eslint/config-array": {
        "minimatch": "11.0.1"
      }
    }
  }
}
